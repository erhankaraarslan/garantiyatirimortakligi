{
  "name": "gyo",
  "version": "1.0.0",
  "description": "Garanti Yatırım Ortaklığı kurumsal sitesi (Next.js + Payload + PostgreSQL)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "sh scripts/link-volume-uploads.sh && cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate:fetch": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/legacy/fetch-pages.ts",
    "migrate:parse": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/legacy/parse-pages.ts",
    "migrate:docs": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/legacy/download-documents.ts",
    "migrate:seed": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/legacy/seed.ts",
    "migrate:verify": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/legacy/verify.ts",
    "migrate:redirects": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/legacy/generate-redirects.ts",
    "migrate:parity": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/legacy/en-parity.ts",
    "migrate:en-complete": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/legacy/en-complete.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-search": "^3.88.0",
    "@payloadcms/plugin-seo": "^3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.88.0",
    "postcss": "^8.5.26",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "cheerio": "^1.2.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "p-limit": "^7.3.1",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^10 || ^11"
  }
}
