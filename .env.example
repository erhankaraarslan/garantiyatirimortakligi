# --- Zorunlu ---
DATABASE_URL=postgres://user@127.0.0.1:5432/gyo_cms
PAYLOAD_SECRET=degistir-bunu-uzun-rastgele-bir-deger-yap

# Kanonik site adresi; sitemap ve hreflang etiketleri bunu kullanır
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Yerel disk / NFS ---
# media/ ve documents/ klasörlerinin kökü. Boşsa MEDIA_SHARED_MOUNT'ın
# bağlandığı klasöre (ör. gbnasgyosharedarea:/gyosharedarea), o da yoksa
# uygulama klasörüne yazılır.
UPLOADS_DIR=
MEDIA_SHARED_MOUNT=

# --- Depolama (üretim) ---
# S3_BUCKET tanımlıysa yüklemeler S3/R2'ye gider, tanımsızsa yerel diske yazılır.
# 268 MB'lık PDF arşivi salt-okunur dosya sistemlerinde (Vercel) diske yazılamaz.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- İletişim formu ---
CONTACT_FORM_TO=yo@gyo.com.tr
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Migration script'leri ---
# Eski siteden indirilen HTML sayfalarının bulunduğu klasör
LEGACY_SNAPSHOT_DIR=./.migration/pages
LEGACY_BASE_URL=http://www.gyo.com.tr
